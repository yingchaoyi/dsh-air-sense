{
  "name": "dsh-air-sense",
  "version": "0.1.12",
  "description": "DSH 插件 · 读空气：AstrBot 群消息进 DSH 之前先判断该不该接话——概率、活跃度、密度、静默、氛围、自适应分数，可开关可调，判断失败不拦消息。",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "patch",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "astrbot",
    "qq",
    "read-the-room"
  ],
  "license": "MIT",
  "author": "yingchaoyi",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/client-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
